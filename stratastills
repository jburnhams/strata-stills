#!/bin/bash
# Launcher: runs the stratastills CLI with the project environment. Override the interpreter with STRATA_PYTHON.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${STRATA_PYTHON:-$ROOT/.venv/bin/python}"; [ -x "$PY" ] || PY="$ROOT/.venv/Scripts/python.exe"
exec env PYTHONPATH="$ROOT/src" PYTHONWARNINGS=ignore "$PY" -m stratastills "$@"
